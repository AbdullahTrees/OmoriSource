+  const sprite = new Sprite();
+  const actions = [];
+  sprite.synchronizeHorrorFiltersWithSource = function() { actions.push('sync'); };
+  sprite.runChildren = function() {
+    actions.push('children');
+    this._horrorFilters.tvFilter = { animated: true, time: 0, aniSpeed: 2 };
+  };
